{
  "name": "@sisyphus/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./dashboard": {
      "types": "./dist/DashboardApp.d.ts",
      "import": "./dist/DashboardApp.js"
    },
    "./demo-client": {
      "types": "./dist/demo-client.d.ts",
      "import": "./dist/demo-client.js"
    },
    "./session-client": {
      "types": "./dist/session-client.d.ts",
      "import": "./dist/session-client.js"
    },
    "./demo": {
      "types": "./dist/demo-data.d.ts",
      "import": "./dist/demo-data.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sisyphus/domain": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
