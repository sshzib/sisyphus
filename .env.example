# The values below show the full cloud-managed development mode.
# For Electron offline-default mode, unset SISYPHUS_POLICY_FILE and all of:
# SISYPHUS_CONTROL_PLANE_URL, SISYPHUS_DEVICE_TOKEN, SISYPHUS_POLICY_PUBLIC_KEYS,
# SISYPHUS_TENANT_ID, SISYPHUS_DEVICE_ID, SISYPHUS_ADAPTER_INSTALLATION_ID,
# SISYPHUS_ADAPTER_CONFIGURATION_DIGEST, and SISYPHUS_RUNTIME_PROFILE.
# For local-policy mode, set SISYPHUS_POLICY_FILE and leave that cloud group unset.
# Cloud-managed mode requires the policy file and the complete cloud identity group.
# On first Electron enrollment, SISYPHUS_DEVICE_TOKEN is encrypted with safeStorage.
# Later Electron launches can omit it and load the stored device token.
SISYPHUS_API_HOST=127.0.0.1
SISYPHUS_API_PORT=7330
SISYPHUS_WORKER_HOST=127.0.0.1
SISYPHUS_WORKER_PORT=7331
SISYPHUS_DATA_DIR=
SISYPHUS_POLICY_FILE=examples/worker-policy.json
SISYPHUS_HOOK_TOKEN=
SISYPHUS_MCP_TOKEN=
SISYPHUS_DESKTOP_TOKEN=
SISYPHUS_REPOSITORY_MODE=memory
SISYPHUS_DATABASE_URL=postgres://sisyphus_app:sisyphus_app@127.0.0.1:5432/sisyphus
SISYPHUS_MIGRATION_DATABASE_URL=postgres://sisyphus:sisyphus@127.0.0.1:5432/sisyphus
SISYPHUS_DEVICE_TOKEN=device-delta-token
SISYPHUS_EVIDENCE_KEY=
SISYPHUS_CONTROL_PLANE_URL=http://127.0.0.1:7330
SISYPHUS_POLICY_PUBLIC_KEYS={}
SISYPHUS_TENANT_ID=tenant-acme
SISYPHUS_DEVICE_ID=device-delta
SISYPHUS_ADAPTER_INSTALLATION_ID=installation-codex-local
SISYPHUS_ADAPTER_CONFIGURATION_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SISYPHUS_RUNTIME_PROFILE=local
SISYPHUS_SECRET_ENCRYPTION_KEY=
SISYPHUS_POLICY_SIGNING_KEY=
SISYPHUS_POLICY_KEY_ID=sisyphus-development
SISYPHUS_WEB_ORIGIN=http://localhost:3000
SISYPHUS_WEB_API_URL=http://127.0.0.1:7330
SISYPHUS_WEB_SESSION_KEY=
SISYPHUS_DESKTOP_MANAGE_WORKER=true
SISYPHUS_WORKER_URL=http://127.0.0.1:7331
SISYPHUS_API_URL=http://127.0.0.1:7330
SISYPHUS_DESKTOP_API_TOKEN=demo-admin
