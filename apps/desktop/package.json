{
  "name": "@sisyphus/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.main.json && node scripts/stage-worker.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "package": "pnpm build && electron-builder",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@sisyphus/ui": "workspace:*",
    "@sisyphus/worker": "workspace:*",
    "electron": "^37.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.sisyphus.supervisor",
    "productName": "Sisyphus",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-worker",
        "to": "worker"
      }
    ],
    "asarUnpack": [
      "node_modules/@sisyphus/worker/**"
    ]
  }
}
